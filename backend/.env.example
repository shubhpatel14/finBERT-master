# EdgeFinder Backend Configuration
PORT=8000
HOST=0.0.0.0
# For PostgreSQL in production, supply: postgresql://user:password@localhost:5432/edgefinder
# If DATABASE_URL is unset, falls back seamlessly to sqlite:///./edgefinder.db
DATABASE_URL=sqlite:///./edgefinder.db
FINBERT_MODEL_NAME=ProsusAI/finbert
